# Shared local development defaults

DATA_DIR=./data

OLLAMA_BASE_URL=http://127.0.0.1:11434
TEXT_MODEL=qwen3:8b
VISION_MODEL=qwen2.5vl:7b
EMBEDDING_MODEL=BAAI/bge-m3

CHROMA_COLLECTION=petroleum_knowledge
ANONYMIZED_TELEMETRY=False
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
TOP_K=5
SIMILARITY_THRESHOLD=0.10

OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_TEMPERATURE=0

AGGREGATE_BATCH_SIZE=500
AGGREGATE_MAX_RESULTS=100
AGGREGATE_MAX_PER_DOCUMENT=10
FIGURE_NOTE_MIN_CONFIDENCE=0.5

EMBEDDING_MODEL_PATH=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Approved workspace Agent
AGENT_WORKSPACE_DIR=./workspace
AGENT_MAX_FILE_BYTES=5242880
AGENT_MAX_READ_CHARACTERS=50000
AGENT_PYTHON_TIMEOUT_SECONDS=30
AGENT_PYTHON_MAX_CODE_CHARACTERS=30000
AGENT_PYTHON_OUTPUT_CHARACTERS=20000

# Frontend
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api
